        ],
        "summary": "Returns all Users as response DTOs rather than exposing entities.",
        "description": "Returns the current collection of users.\nAn empty collection is returned when no users exist.\nEntities are not exposed directly; UserResponse DTOs\nare returned instead.",
        "responses": {
          "200": {
            "description": "Returns the collection of users.",
            "content": {
