      "post": {
        "tags": [
          "Users"
        ],
        "summary": "FluentValidation checks the request before this action executes.",
        "description": "Creates a user from the supplied request.\nThe API generates values such as the user's identifier.\nThe caller cannot provide those values.\n\nFluentValidation validates the request before the controller\naction executes.",
