{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",

      "Jwt": {
        "Issuer": "RondiTrack",
        "Audience": "RondiTrack.Api",
        "AccessTokenMinutes": 10
      }
    }
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Contribution": {
    "PermitLimit": 30,
    "WindowSeconds": 60
    },
    "Payout": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },

  "AllowedHosts": "*"
}
